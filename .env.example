# Copia este archivo a ".env" y rellena los valores antes de desplegar.

# --- API de Anthropic (facturacion por token, separada de tu suscripcion Claude) ---
# Generala en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelo a usar para las respuestas automaticas. claude-haiku-4-5 es mas barato
# para chat casual; claude-sonnet-5 da respuestas de mejor calidad a mayor costo.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=500

# Personalidad / instrucciones del bot (edita libremente)
SYSTEM_PROMPT=Eres el asistente personal de WhatsApp del dueno de este numero. Responde de forma breve, natural y en el mismo idioma del mensaje recibido.

# --- Token del bridge de WhatsApp ---
# Puedes dejarlo vacio en el PRIMER despliegue: el bridge genera uno solo y lo
# imprime en los logs (docker logs -f whatsapp-claude-bot). Cópialo aquí y
# reinicia el contenedor para que el autoresponder pueda autenticarse.
WHATSAPP_BRIDGE_TOKEN=

# --- Control de acceso ---
# Lista de chats (numero@s.whatsapp.net o JID de grupo) a los que el bot
# tiene permitido responder. Vacio = responde a cualquiera que te escriba
# (NO recomendado). Ejemplo: 521XXXXXXXXXX@s.whatsapp.net,otronumero@s.whatsapp.net
ALLOWED_CHAT_JIDS=

# Cuantos mensajes de contexto por chat mantiene en memoria (se pierde al reiniciar)
HISTORY_LIMIT=20

# --- Variables internas (normalmente no hace falta tocarlas) ---
WHATSAPP_API_URL=http://127.0.0.1:8080/api
PORT=8769
